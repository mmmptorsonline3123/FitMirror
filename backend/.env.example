# Copy to backend/.env. Never commit real values.
APP_ENV=development            # development | test | production
JWT_SECRET=                    # 32+ random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_TTL_MINUTES=10080
COOKIE_SECURE=true             # false only for plain-http localhost

MONGO_URI=                     # mongodb+srv://USER:PASS@cluster.mongodb.net  ("mongomock://" = in-memory, tests only)
MONGO_DB=fitmirror

# Cloudflare R2 (S3-compatible). Bucket must be PRIVATE (no public access / r2.dev URL).
S3_ENDPOINT_URL=               # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=fitmirror-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
SIGNED_URL_TTL_SECONDS=300

POSE_MODEL_PATH=models/pose_landmarker_full.task
POSE_DETECTOR=mediapipe        # "fake" = test/E2E only; refused when APP_ENV=production
MAX_UPLOAD_MB=12

# Body model. Only "silhouette" exists; "smplx" needs licensed (non-commercial) model files and isn't implemented.
BODY_MODEL=silhouette

# GPU inference (Render has no GPU). "fake" = tests/E2E only; refused when APP_ENV=production.
INFERENCE_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL=cuuupid/idm-vton          # NON-COMMERCIAL license
REPLICATE_SEGMENT_MODEL=schananas/grounded_sam
REPLICATE_CLASSIFY_MODEL=yorickvp/llava-13b

# Feature flags
FEATURE_3D_GARMENT=false       # P5 3D garment preview (labelled "Preview" in the UI)

# URL ingestion: "host:port,..." exempt from the public-IP/port SSRF checks. Test/E2E only; MUST be empty in production
# (the app refuses to start with it set when APP_ENV=production).
URL_FETCH_ALLOW=
